# Copia este archivo a `.env` y rellena los valores. NO subas .env a Git.

# Tu API key de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar. Por defecto claude-sonnet-4-6 (mejor relación calidad/velocidad).
# Alternativas:
#   claude-haiku-4-5-20251001  → más rápido y barato
#   claude-opus-4-7            → máxima precisión, más lento
MODEL=claude-sonnet-4-6

# Puerto del servidor
PORT=3000
